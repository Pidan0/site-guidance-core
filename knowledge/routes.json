{
  "version": "2.0.0",
  "notes": "数组顺序即优先级。override路线在基础路线选出后检查，命中时替换路线但保留基础路线的能力义务。每条路线的when按顺序求值，第一条命中的规则决定路线；条件DSL见docs/API.md。",
  "routes": [
    {
      "id": "existing-platform", "name": "保留并改进已有平台", "execution": "guided", "guide": "guides/migration.md", "override": true,
      "candidates": ["客户现有平台"], "summary": "现有系统能满足需求时，优先配置和改进，避免无依据重建。",
      "when": [
        {
          "id": "existing-platform.meets-needs", "reason": "已确认 {existing.platform} 可满足需求，先保留现有系统。",
          "if": { "all": [
            { "field": "existing.platform", "exists": true }, { "field": "existing.meetsNeeds", "is": true },
            { "not": { "field": "existing.migrationRequired", "is": true } },
            { "not": { "field": "ownership.selfHost", "is": true } }, { "not": { "field": "ownership.sourceCode", "is": true } }
          ] }
        }
      ]
    },
    {
      "id": "discovery", "name": "先澄清目标", "execution": "discovery", "guide": "guides/intake.md",
      "candidates": [], "summary": "关键业务目标尚未明确，先取得会改变路线的信息。",
      "when": [
        { "id": "discovery.no-goal", "if": { "field": "goals", "exists": false }, "reason": "尚未确认访客要在网站完成的动作，先澄清目标再选路线。" }
      ]
    },
    {
      "id": "custom-app", "name": "业务应用专项设计", "execution": "guided", "guide": "guides/content-app.md",
      "candidates": ["按业务模型选择应用方案"], "summary": "先设计用户、权限、数据、操作与异常状态，再评估应用开发。",
      "when": [
        { "id": "custom-app.accounts", "if": { "ref": "needsApplication" }, "capabilities": ["application"], "reason": "需要客户账号、权限或应用行为，静态页面无法承担后台职责。" }
      ]
    },
    {
      "id": "ticketing-integration", "name": "票务系统专项接入", "execution": "guided", "guide": "guides/tickets-booking.md",
      "candidates": ["客户票务供应商或适用行业系统"], "summary": "先核对日期、场次、容量、核销、改退和对账，不能用普通商品页代替票务系统。",
      "when": [
        {
          "id": "ticketing-integration.transactional", "if": { "all": [{ "goal": "tickets" }, { "ref": "transactionalFeatures" }] },
          "reason": "需要票务交易或容量管理，必须确认专用票务能力。"
        },
        {
          "id": "ticketing-integration.unclear", "if": { "all": [{ "goal": "tickets" }, { "not": { "ref": "externalCheckoutHandles" } }] },
          "reason": "票务承接方式未明确，暂不生成可能误导的售票页面。"
        }
      ]
    },
    {
      "id": "tourism-referral", "name": "文旅内容站与已有购票入口", "execution": "local", "guide": "guides/tickets-booking.md",
      "candidates": ["本核心静态生成器", "客户现有票务系统"], "summary": "站点解释体验和票品，购买与订单继续由外部票务系统承接。",
      "when": [
        {
          "id": "tourism-referral.external-checkout", "if": { "all": [{ "goal": "tickets" }, { "ref": "externalCheckoutHandles" }] },
          "reason": "已明确只引导到现有购票入口，不在此站内处理订单。"
        }
      ]
    },
    {
      "id": "booking-referral", "name": "服务展示与已有预约入口", "execution": "local", "guide": "guides/tickets-booking.md",
      "candidates": ["本核心静态生成器", "客户现有预约系统"], "summary": "介绍服务并引导到已存在的预约入口。",
      "when": [
        {
          "id": "booking-referral.external-booking", "if": { "all": [{ "goal": "booking" }, { "ref": "externalBookingHandles" }] },
          "reason": "预约由已提供的外部入口承接。"
        }
      ]
    },
    {
      "id": "managed-booking", "name": "预约服务接入", "execution": "guided", "guide": "guides/tickets-booking.md",
      "candidates": ["适用的预约平台或已有供应商"], "summary": "核对时区、时段容量、支付、改期及取消规则后接入预约系统。",
      "when": [
        { "id": "managed-booking.booking", "if": { "goal": "booking" }, "reason": "需要时段、容量和预约状态，应先接入实际预约系统。" }
      ]
    },
    {
      "id": "commerce-referral", "name": "展示站与已有商城入口", "execution": "local", "guide": "guides/commerce.md",
      "candidates": ["本核心静态生成器", "客户现有商城"], "summary": "网站只介绍商品并链接已有商城，支付和订单在外部系统完成。",
      "when": [
        {
          "id": "commerce-referral.external-checkout", "if": { "all": [{ "ref": "commerceSignals" }, { "ref": "externalCheckoutHandles" }] },
          "reason": "已明确由外部商城处理购买和订单，本站负责介绍与引导。"
        }
      ]
    },
    {
      "id": "owned-commerce", "name": "自托管电商底座", "execution": "guided", "guide": "guides/commerce.md",
      "candidates": ["WooCommerce", "Medusa", "Saleor", "Vendure"], "summary": "按自托管约束评估电商底座、许可证、支付连接器和长期运维。",
      "when": [
        {
          "id": "owned-commerce.self-host", "if": { "all": [{ "ref": "commerceSignals" }, { "field": "ownership.selfHost", "is": true }] },
          "capabilities": ["commerce"], "reason": "必须自托管，需要能自行运行的交易底座。"
        }
      ]
    },
    {
      "id": "hybrid-commerce", "name": "自有店面与外部交易后台", "execution": "guided", "guide": "guides/commerce.md",
      "candidates": ["自有前台与成熟交易API"], "summary": "保留自有前台代码，交易交给外部服务；需要另行实现和验证连接器。",
      "when": [
        {
          "id": "hybrid-commerce.source-code", "if": { "all": [{ "ref": "commerceSignals" }, { "field": "ownership.sourceCode", "is": true }] },
          "capabilities": ["commerce"], "reason": "要求自有代码，需区分自有店面与外部交易后台。"
        }
      ]
    },
    {
      "id": "managed-commerce", "name": "成熟平台建店", "execution": "guided", "guide": "guides/commerce.md",
      "candidates": ["Shopify", "SHOPLINE", "Shoplazza"], "summary": "在成熟平台配置店面、支付、订单和履约；具体平台需结合地区与账户核实。",
      "when": [
        { "id": "managed-commerce.platform", "if": { "ref": "commerceSignals" }, "capabilities": ["commerce"], "reason": "需要交易经营能力，优先比较成熟平台。" }
      ]
    },
    {
      "id": "cms-owned", "name": "带内容后台的网站", "execution": "guided", "guide": "guides/content-app.md",
      "candidates": ["Payload", "WordPress", "适用CMS"], "summary": "客户需要自行登录改内容时，接入内容模型、权限、预览与发布后台。",
      "when": [
        { "id": "cms-owned.client-editor", "if": { "feature": "contentEditor", "is": "client" }, "reason": "客户要登录后台改内容，需要内容管理系统。" }
      ]
    },
    {
      "id": "static-owned", "name": "自有展示与询盘站", "execution": "local", "guide": "guides/static-site.md",
      "candidates": ["本核心静态生成器"], "summary": "用可持久化内容生成可修改、可交接的展示站。",
      "when": [
        { "id": "static-owned.default", "if": { "all": [] }, "reason": "当前目标可由展示、目录、内容与联系方式完成。" }
      ]
    }
  ]
}
