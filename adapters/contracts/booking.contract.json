{
  "schemaVersion": 1,
  "kind": "booking",
  "version": "1.0.0",
  "capability": "booking",
  "summary": "预约连接器：占位、确认、改期、取消与完成；时间以带时区的ISO 8601字符串表达。",
  "notes": "契约只定义连接器必须满足的行为，不代表任何后台已接通；能力状态仍以knowledge/capabilities.json为准。用法见adapters/README.md。",
  "interface": {
    "operations": "连接器对象上同名的异步方法，入参和返回值为JSON对象；失败时抛出带code的错误。",
    "ingestEvent": "async ingestEvent(rawBody, headers) → { status: \"applied\"|\"duplicate\", entityId, state }；仅在存在入站事件时必需。",
    "onEvent": "onEvent(handler) → 取消订阅函数；handler接收出站事件信封；仅在存在出站事件时必需。",
    "envelope": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "entityId": { "type": "string", "minLength": 1 },
        "occurredAt": { "type": "string", "minLength": 1 },
        "data": { "type": "object" }
      },
      "required": ["id", "type", "entityId", "occurredAt"]
    }
  },
  "operations": [
    {
      "name": "createBooking",
      "summary": "为服务时段占位；初始状态pending。",
      "idempotent": true,
      "creates": true,
      "input": {
        "type": "object",
        "properties": {
          "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 },
          "serviceId": { "type": "string", "minLength": 1 },
          "start": { "type": "string", "minLength": 1 },
          "timeZone": { "type": "string", "minLength": 1 },
          "customer": {
            "type": "object",
            "properties": { "name": { "type": "string", "minLength": 1 }, "email": { "type": "string", "minLength": 1 } }
          }
        },
        "required": ["idempotencyKey", "serviceId", "start", "timeZone"]
      },
      "output": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "minLength": 1 },
          "serviceId": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "state", "serviceId"]
      },
      "errors": ["VALIDATION_FAILED", "IDEMPOTENCY_CONFLICT", "CAPACITY_EXCEEDED"]
    },
    {
      "name": "getBooking",
      "summary": "按id读取当前状态；必须返回契约状态名。",
      "input": { "type": "object", "properties": { "id": { "type": "string", "minLength": 1 } }, "required": ["id"] },
      "output": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "state": { "type": "string", "minLength": 1 } },
        "required": ["id", "state"]
      },
      "errors": ["NOT_FOUND"]
    },
    {
      "name": "confirmBooking",
      "summary": "无需预付的预约由系统直接确认。",
      "idempotent": true,
      "input": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 } },
        "required": ["id", "idempotencyKey"]
      },
      "output": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "state": { "type": "string", "minLength": 1 } },
        "required": ["id", "state"]
      },
      "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "IDEMPOTENCY_CONFLICT", "VALIDATION_FAILED"]
    },
    {
      "name": "rescheduleBooking",
      "summary": "把已确认预约改到新时段，原时段释放、预约编号不变。",
      "idempotent": true,
      "input": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 },
          "newStart": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "idempotencyKey"]
      },
      "output": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "state": { "type": "string", "minLength": 1 } },
        "required": ["id", "state"]
      },
      "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "IDEMPOTENCY_CONFLICT", "VALIDATION_FAILED", "CAPACITY_EXCEEDED"]
    },
    {
      "name": "cancelBooking",
      "summary": "取消预约并释放容量。",
      "idempotent": true,
      "input": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 },
          "reason": { "type": "string" }
        },
        "required": ["id", "idempotencyKey"]
      },
      "output": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "state": { "type": "string", "minLength": 1 } },
        "required": ["id", "state"]
      },
      "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "IDEMPOTENCY_CONFLICT", "VALIDATION_FAILED"]
    },
    {
      "name": "completeBooking",
      "summary": "标记服务已完成。",
      "idempotent": true,
      "input": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 } },
        "required": ["id", "idempotencyKey"]
      },
      "output": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "state": { "type": "string", "minLength": 1 } },
        "required": ["id", "state"]
      },
      "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "IDEMPOTENCY_CONFLICT", "VALIDATION_FAILED"]
    },
    {
      "name": "markNoShow",
      "summary": "标记客户爽约。",
      "idempotent": true,
      "input": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 } },
        "required": ["id", "idempotencyKey"]
      },
      "output": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "state": { "type": "string", "minLength": 1 } },
        "required": ["id", "state"]
      },
      "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "IDEMPOTENCY_CONFLICT", "VALIDATION_FAILED"]
    },
    {
      "name": "listSlots",
      "summary": "列出时间范围内的可约时段。",
      "query": true,
      "input": {
        "type": "object",
        "properties": {
          "serviceId": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        },
        "required": ["serviceId", "from", "to"]
      },
      "output": { "type": "object", "properties": { "slots": { "type": "array" } }, "required": ["slots"] },
      "errors": ["VALIDATION_FAILED"]
    }
  ],
  "events": [
    {
      "name": "payment.succeeded",
      "direction": "inbound",
      "summary": "预付款成功，预约生效。",
      "data": {
        "type": "object",
        "properties": {
          "paymentId": { "type": "string", "minLength": 1 },
          "amount": { "type": "number" },
          "currency": { "type": "string", "minLength": 1 }
        },
        "required": ["paymentId"]
      }
    },
    { "name": "hold.expired", "direction": "inbound", "summary": "占位超时未确认。", "data": { "type": "object", "properties": {  } } },
    { "name": "booking.confirmed", "direction": "outbound", "summary": "预约已确认。", "data": { "type": "object", "properties": {  } } },
    { "name": "booking.cancelled", "direction": "outbound", "summary": "预约已取消。", "data": { "type": "object", "properties": {  } } },
    { "name": "booking.rescheduled", "direction": "outbound", "summary": "预约已改期。", "data": { "type": "object", "properties": {  } } },
    { "name": "booking.expired", "direction": "outbound", "summary": "占位已过期。", "data": { "type": "object", "properties": {  } } }
  ],
  "lifecycle": {
    "entity": "booking",
    "create": "createBooking",
    "read": "getBooking",
    "initial": "pending",
    "states": ["pending", "confirmed", "cancelled", "completed", "no_show", "expired"],
    "terminal": ["cancelled", "completed", "no_show", "expired"],
    "transitions": [
      { "from": "pending", "to": "confirmed", "via": { "event": "payment.succeeded" }, "emits": "booking.confirmed" },
      { "from": "pending", "to": "confirmed", "via": { "operation": "confirmBooking" }, "emits": "booking.confirmed" },
      { "from": "pending", "to": "expired", "via": { "event": "hold.expired" }, "emits": "booking.expired" },
      { "from": "pending", "to": "cancelled", "via": { "operation": "cancelBooking" }, "emits": "booking.cancelled" },
      { "from": "confirmed", "to": "confirmed", "via": { "operation": "rescheduleBooking" }, "emits": "booking.rescheduled" },
      { "from": "confirmed", "to": "cancelled", "via": { "operation": "cancelBooking" }, "emits": "booking.cancelled" },
      { "from": "confirmed", "to": "completed", "via": { "operation": "completeBooking" } },
      { "from": "confirmed", "to": "no_show", "via": { "operation": "markNoShow" } }
    ]
  },
  "errors": [
    { "code": "VALIDATION_FAILED", "meaning": "输入缺字段或取值不合格式；不产生任何副作用。", "retryable": false },
    { "code": "NOT_FOUND", "meaning": "指定id的对象不存在。", "retryable": false },
    { "code": "ILLEGAL_TRANSITION", "meaning": "当前状态不允许该操作或事件；状态保持不变，不静默忽略。", "retryable": false },
    { "code": "IDEMPOTENCY_CONFLICT", "meaning": "同一idempotencyKey被用于不同的输入。", "retryable": false },
    { "code": "SIGNATURE_INVALID", "meaning": "事件签名缺失或不匹配；事件不被处理。", "retryable": false },
    { "code": "SIGNATURE_EXPIRED", "meaning": "事件时间戳超出容忍窗口；事件不被处理。", "retryable": false },
    { "code": "UPSTREAM_UNAVAILABLE", "meaning": "上游供应商暂时不可用；调用方可以用同一idempotencyKey重试。", "retryable": true },
    { "code": "CAPACITY_EXCEEDED", "meaning": "时段容量不足或与同一资源的已有预约重叠；不占位，容量不变。", "retryable": false }
  ],
  "conformance": {
    "create": {
      "serviceId": "SERVICE-TEST-1",
      "start": "2030-03-10T09:00:00-04:00",
      "timeZone": "America/New_York",
      "customer": { "name": "Test", "email": "guest@example.com" }
    },
    "createAlt": {
      "serviceId": "SERVICE-TEST-2",
      "start": "2030-03-11T09:00:00-04:00",
      "timeZone": "America/New_York",
      "customer": { "name": "Other", "email": "other@example.com" }
    },
    "operations": {
      "confirmBooking": {  },
      "rescheduleBooking": { "newStart": "2030-03-12T09:00:00-04:00" },
      "cancelBooking": { "reason": "test" },
      "completeBooking": {  },
      "markNoShow": {  }
    },
    "events": { "payment.succeeded": { "paymentId": "pay_test_1", "amount": 1, "currency": "USD" }, "hold.expired": {  } }
  },
  "idempotency": {
    "operations": "带idempotencyKey的操作：同键同输入返回相同结果且只产生一次副作用；同键不同输入抛IDEMPOTENCY_CONFLICT；键至少保留24小时。",
    "events": "入站事件以信封id去重：重复投递返回{status:\"duplicate\"}，不重复变更状态、不重复发出出站事件。",
    "outbound": "每次状态转换最多发出一次出站事件，事件id稳定，幂等重放不再发出。"
  },
  "signature": {
    "required": true,
    "scheme": "hmac-sha256",
    "headers": { "signature": "x-signature", "timestamp": "x-timestamp" },
    "signedPayload": "`${timestamp}.${rawBody}`，rawBody为投递的原始JSON字符串；x-signature取值为\"v1=<十六进制摘要>\"",
    "toleranceSeconds": 300,
    "rules": ["先验签再解析业务字段", "签名不符抛SIGNATURE_INVALID，时间戳超窗抛SIGNATURE_EXPIRED", "密钥只来自宿主安全配置，不写入仓库或project.json"]
  }
}
