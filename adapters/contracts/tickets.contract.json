{
  "schemaVersion": 1,
  "kind": "tickets",
  "version": "1.0.0",
  "capability": "tickets",
  "summary": "票务连接器：占位、出票、核销、改期与退款。",
  "notes": "契约只定义连接器必须满足的行为，不代表任何后台已接通；能力状态仍以knowledge/capabilities.json为准。用法见adapters/README.md。",
  "interface": {
    "operations": "连接器对象上同名的异步方法，入参和返回值为JSON对象；失败时抛出带code的错误。",
    "ingestEvent": "async ingestEvent(rawBody, headers) → { status: \"applied\"|\"duplicate\", entityId, state }；仅在存在入站事件时必需。",
    "onEvent": "onEvent(handler) → 取消订阅函数；handler接收出站事件信封；仅在存在出站事件时必需。",
    "envelope": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "entityId": { "type": "string", "minLength": 1 },
        "occurredAt": { "type": "string", "minLength": 1 },
        "data": { "type": "object" }
      },
      "required": ["id", "type", "entityId", "occurredAt"]
    }
  },
  "operations": [
    {
      "name": "issueTicket",
      "summary": "为场次占位并创建票；初始状态reserved，支付确认前不得作为有效凭证。",
      "idempotent": true,
      "creates": true,
      "input": {
        "type": "object",
        "properties": {
          "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 },
          "sessionId": { "type": "string", "minLength": 1 },
          "ticketType": { "type": "string", "minLength": 1 },
          "holder": { "type": "object", "properties": { "name": { "type": "string", "minLength": 1 } } }
        },
        "required": ["idempotencyKey", "sessionId", "ticketType"]
      },
      "output": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "minLength": 1 },
          "sessionId": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "state", "sessionId"]
      },
      "errors": ["VALIDATION_FAILED", "IDEMPOTENCY_CONFLICT", "CAPACITY_EXCEEDED"]
    },
    {
      "name": "getTicket",
      "summary": "按id读取当前状态；必须返回契约状态名。",
      "input": { "type": "object", "properties": { "id": { "type": "string", "minLength": 1 } }, "required": ["id"] },
      "output": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "state": { "type": "string", "minLength": 1 } },
        "required": ["id", "state"]
      },
      "errors": ["NOT_FOUND"]
    },
    {
      "name": "cancelTicket",
      "summary": "取消未付款的占位并释放容量。",
      "idempotent": true,
      "input": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 } },
        "required": ["id", "idempotencyKey"]
      },
      "output": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "state": { "type": "string", "minLength": 1 } },
        "required": ["id", "state"]
      },
      "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "IDEMPOTENCY_CONFLICT", "VALIDATION_FAILED"]
    },
    {
      "name": "redeemTicket",
      "summary": "核销已出票的票；每张票只能核销一次。",
      "idempotent": true,
      "input": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 },
          "gate": { "type": "string" }
        },
        "required": ["id", "idempotencyKey"]
      },
      "output": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "state": { "type": "string", "minLength": 1 } },
        "required": ["id", "state"]
      },
      "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "IDEMPOTENCY_CONFLICT", "VALIDATION_FAILED"]
    },
    {
      "name": "rescheduleTicket",
      "summary": "把已出票的票改到另一场次，原场次容量释放。",
      "idempotent": true,
      "input": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 },
          "newSessionId": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "idempotencyKey"]
      },
      "output": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "state": { "type": "string", "minLength": 1 } },
        "required": ["id", "state"]
      },
      "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "IDEMPOTENCY_CONFLICT", "VALIDATION_FAILED", "CAPACITY_EXCEEDED"]
    },
    {
      "name": "requestRefund",
      "summary": "对已出票且未核销的票发起退款。",
      "idempotent": true,
      "input": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 },
          "reason": { "type": "string" }
        },
        "required": ["id", "idempotencyKey"]
      },
      "output": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1 }, "state": { "type": "string", "minLength": 1 } },
        "required": ["id", "state"]
      },
      "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "IDEMPOTENCY_CONFLICT", "VALIDATION_FAILED"]
    },
    {
      "name": "getAvailability",
      "summary": "读取场次剩余容量。",
      "query": true,
      "input": { "type": "object", "properties": { "sessionId": { "type": "string", "minLength": 1 } }, "required": ["sessionId"] },
      "output": {
        "type": "object",
        "properties": { "sessionId": { "type": "string", "minLength": 1 }, "remaining": { "type": "number" } },
        "required": ["sessionId", "remaining"]
      },
      "errors": ["VALIDATION_FAILED", "NOT_FOUND"]
    }
  ],
  "events": [
    {
      "name": "payment.succeeded",
      "direction": "inbound",
      "summary": "支付服务商确认付款成功，票生效。",
      "data": {
        "type": "object",
        "properties": {
          "paymentId": { "type": "string", "minLength": 1 },
          "amount": { "type": "number" },
          "currency": { "type": "string", "minLength": 1 }
        },
        "required": ["paymentId"]
      }
    },
    { "name": "reservation.expired", "direction": "inbound", "summary": "占位超时未付款。", "data": { "type": "object", "properties": {  } } },
    {
      "name": "refund.completed",
      "direction": "inbound",
      "summary": "退款完成。",
      "data": {
        "type": "object",
        "properties": { "refundId": { "type": "string", "minLength": 1 }, "amount": { "type": "number" } },
        "required": ["refundId"]
      }
    },
    {
      "name": "refund.failed",
      "direction": "inbound",
      "summary": "退款失败，票恢复有效。",
      "data": {
        "type": "object",
        "properties": { "refundId": { "type": "string", "minLength": 1 }, "amount": { "type": "number" } },
        "required": ["refundId"]
      }
    },
    { "name": "ticket.issued", "direction": "outbound", "summary": "票已生效。", "data": { "type": "object", "properties": {  } } },
    { "name": "ticket.redeemed", "direction": "outbound", "summary": "票已核销。", "data": { "type": "object", "properties": {  } } },
    { "name": "ticket.expired", "direction": "outbound", "summary": "占位已过期。", "data": { "type": "object", "properties": {  } } },
    { "name": "ticket.cancelled", "direction": "outbound", "summary": "占位已取消。", "data": { "type": "object", "properties": {  } } },
    { "name": "ticket.refunded", "direction": "outbound", "summary": "票已退款。", "data": { "type": "object", "properties": {  } } }
  ],
  "lifecycle": {
    "entity": "ticket",
    "create": "issueTicket",
    "read": "getTicket",
    "initial": "reserved",
    "states": ["reserved", "issued", "redeemed", "expired", "cancelled", "refund_pending", "refunded"],
    "terminal": ["redeemed", "expired", "cancelled", "refunded"],
    "transitions": [
      { "from": "reserved", "to": "issued", "via": { "event": "payment.succeeded" }, "emits": "ticket.issued" },
      { "from": "reserved", "to": "expired", "via": { "event": "reservation.expired" }, "emits": "ticket.expired" },
      { "from": "reserved", "to": "cancelled", "via": { "operation": "cancelTicket" }, "emits": "ticket.cancelled" },
      { "from": "issued", "to": "redeemed", "via": { "operation": "redeemTicket" }, "emits": "ticket.redeemed" },
      { "from": "issued", "to": "issued", "via": { "operation": "rescheduleTicket" } },
      { "from": "issued", "to": "refund_pending", "via": { "operation": "requestRefund" } },
      { "from": "refund_pending", "to": "refunded", "via": { "event": "refund.completed" }, "emits": "ticket.refunded" },
      { "from": "refund_pending", "to": "issued", "via": { "event": "refund.failed" } }
    ]
  },
  "errors": [
    { "code": "VALIDATION_FAILED", "meaning": "输入缺字段或取值不合格式；不产生任何副作用。", "retryable": false },
    { "code": "NOT_FOUND", "meaning": "指定id的对象不存在。", "retryable": false },
    { "code": "ILLEGAL_TRANSITION", "meaning": "当前状态不允许该操作或事件；状态保持不变，不静默忽略。", "retryable": false },
    { "code": "IDEMPOTENCY_CONFLICT", "meaning": "同一idempotencyKey被用于不同的输入。", "retryable": false },
    { "code": "SIGNATURE_INVALID", "meaning": "事件签名缺失或不匹配；事件不被处理。", "retryable": false },
    { "code": "SIGNATURE_EXPIRED", "meaning": "事件时间戳超出容忍窗口；事件不被处理。", "retryable": false },
    { "code": "UPSTREAM_UNAVAILABLE", "meaning": "上游供应商暂时不可用；调用方可以用同一idempotencyKey重试。", "retryable": true },
    { "code": "CAPACITY_EXCEEDED", "meaning": "场次容量不足；不占位，容量不变。", "retryable": false }
  ],
  "conformance": {
    "create": { "sessionId": "SESSION-TEST-1", "ticketType": "adult", "holder": { "name": "Test Holder" } },
    "createAlt": { "sessionId": "SESSION-TEST-2", "ticketType": "child", "holder": { "name": "Other Holder" } },
    "operations": {
      "cancelTicket": {  },
      "redeemTicket": { "gate": "GATE-1" },
      "rescheduleTicket": { "newSessionId": "SESSION-TEST-3" },
      "requestRefund": { "reason": "test" }
    },
    "events": {
      "payment.succeeded": { "paymentId": "pay_test_1", "amount": 1, "currency": "USD" },
      "reservation.expired": {  },
      "refund.completed": { "refundId": "ref_test_1", "amount": 1 },
      "refund.failed": { "refundId": "ref_test_1", "amount": 1 }
    }
  },
  "idempotency": {
    "operations": "带idempotencyKey的操作：同键同输入返回相同结果且只产生一次副作用；同键不同输入抛IDEMPOTENCY_CONFLICT；键至少保留24小时。",
    "events": "入站事件以信封id去重：重复投递返回{status:\"duplicate\"}，不重复变更状态、不重复发出出站事件。",
    "outbound": "每次状态转换最多发出一次出站事件，事件id稳定，幂等重放不再发出。"
  },
  "signature": {
    "required": true,
    "scheme": "hmac-sha256",
    "headers": { "signature": "x-signature", "timestamp": "x-timestamp" },
    "signedPayload": "`${timestamp}.${rawBody}`，rawBody为投递的原始JSON字符串；x-signature取值为\"v1=<十六进制摘要>\"",
    "toleranceSeconds": 300,
    "rules": ["先验签再解析业务字段", "签名不符抛SIGNATURE_INVALID，时间戳超窗抛SIGNATURE_EXPIRED", "密钥只来自宿主安全配置，不写入仓库或project.json"]
  }
}
